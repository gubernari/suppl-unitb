    RowBox[{"(", 
     FractionBox["s", 
      RowBox[{"s", "+", "Q2"}]], ")"}], "d"], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "The", " ", "absolute", " ", "value", " ", "is", " ", "needed", " ", 
      "for", " ", "the", " ", "Kallen", " ", "funtionbelow", " ", "s"}], "+", 
     RowBox[{".", " ", 
      RowBox[{"See", " ", "[", "33", "]"}]}]}], "*)"}]}]}]], "Input",
