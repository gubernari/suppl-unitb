     "\[IndentingNewLine]", "Q2_", 
    RowBox[{"(*", 
     RowBox[{":", "0"}], "*)"}], ",", "\[IndentingNewLine]", "e_"}], 
   RowBox[{"(*", 
    RowBox[{":", "0"}], "*)"}], "\[IndentingNewLine]", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"kN", ",", "pMR", ",", "subN", ",", "res"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Use", " ", "minimal", " ", "number", " ", "of", " ", "subtractions", 
      " ", "if", " ", "unspecified"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"kN", ",", "pMR"}], "}"}], "=", 
      RowBox[{"Switch", "[", "\[IndentingNewLine]", 
       RowBox[{"\[CapitalGamma]J", ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<V-0\>\"", "|", "\"\<A-0\>\""}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
