Cell[BoxData[
 RowBox[{
  RowBox[{"WBGL", "[", 
   RowBox[{"s_", ",", "K_", ",", "a_", ",", "b_", ",", "c_", ",", "d_", ",", 
    RowBox[{"Q2_", ":", "0"}]}], "]"}], ":=", 
  RowBox[{
   FractionBox["nI", 
    RowBox[{"K", " ", "\[Pi]"}]], 
   RowBox[{"Abs", "[", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"s", "-", "sp"}], ")"}], 
      FractionBox["a", "2"]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"s", "-", "sm"}], ")"}], 
      FractionBox["b", "2"]]}], "]"}], 
   SuperscriptBox["s", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"c", "+", "3"}], ")"}]}]], 
