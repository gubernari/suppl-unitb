Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "GGRegularizedCovariance", " ", "takes", " ", "a", " ", "covariance", " ", 
    "matrix", " ", "and", " ", "makes", " ", "it", " ", "numerically", " ", 
    "safe", " ", "for", " ", 
    RowBox[{"MultinormalDistribution", ".", "\[IndentingNewLine]", "This"}], 
    " ", "is", " ", "to", " ", "avoid", " ", "numerical", " ", 
    "instabilities"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GGRegularizedCovariance", "[", 
      RowBox[{
       RowBox[{"covariance_", "?", "MatrixQ"}], ",", " ", 
       RowBox[{"label_", ":", " ", "Automatic"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "sym", ",", " ", "evals", ",", " ", "scale", ",", " ", "ridge"}], 
        "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"sym", " ", "=", " ", 
         RowBox[{"N", " ", "@", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"covariance", " ", "+", " ", 
              RowBox[{"Transpose", "[", "covariance", "]"}]}], ")"}], "/", 
            "2"}], ")"}]}]}], 
        RowBox[{"(*", 
         RowBox[{"Symmetrize", " ", "covariance"}], "*)"}], ";", "\n", "  ", 
        RowBox[{"evals", " ", "=", " ", 
         RowBox[{"Eigenvalues", "[", "sym", "]"}]}], ";", "\n", "  ", 
        RowBox[{"scale", " ", "=", " ", 
         RowBox[{"Max", " ", "@", " ", 
          RowBox[{"Flatten", " ", "@", " ", 
           RowBox[{"{", 
            RowBox[{"1.", ",", " ", 
             RowBox[{"Abs", "[", 
              RowBox[{"Diagonal", "[", "sym", "]"}], "]"}], ",", " ", 
             RowBox[{"Abs", "[", "evals", "]"}]}], "}"}]}]}]}], ";", "\n", 
        "  ", 
        RowBox[{"ridge", " ", "=", " ", 
         RowBox[{"Max", "[", 
          RowBox[{"0.", ",", " ", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Min", "[", "evals", "]"}]}], " ", "+", " ", 
            RowBox[{
             RowBox[{"10.", "^", 
              RowBox[{"-", "14"}]}], " ", "scale"}]}]}], "]"}]}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "A", " ", "ridge", " ", "is", " ", "a", " ", "small", " ", "number",
            " ", "added", " ", "to", " ", "the", " ", "diagonal", " ", "of", 
           " ", "a", " ", 
           RowBox[{"matrix", ".", " ", "So"}], " ", "if", " ", "one", " ", 
           "eigenvalue", " ", "is", " ", "slightly", " ", "negative", " ", 
           "because", " ", "of", " ", "numerical", " ", "noise"}], ",", 
          RowBox[{"it", " ", "becomes", " ", "positive"}]}], "*)"}], ";", 
        "\n", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ridge", " ", ">", " ", "0"}], " ", "&&", " ", 
           RowBox[{"label", " ", "=!=", " ", "Automatic"}]}], ",", "\n", 
          "    ", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"GGRegularizedCovariance", "::", "ridge"}], ",", " ", 
             "label", ",", " ", "ridge"}], "]"}], ";"}]}], "\n", "  ", "]"}], 
        ";", "\n", "\n", "  ", 
        RowBox[{"sym", " ", "+", " ", 
         RowBox[{"ridge", " ", 
          RowBox[{"IdentityMatrix", "[", 
           RowBox[{"Length", "[", "sym", "]"}], "]"}]}]}]}]}], "\n", "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"GGRegularizedCovariance", "::", "ridge"}], " ", "=", 
     "\"\<Covariance for process `1` was numerically adjusted by adding a \
diagonal ridge of `2`.\>\""}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"GGProcessDistribution", "[", 
      RowBox[{"data_Association", ",", " ", "MTom_String"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "process", "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"process", " ", "=", " ", 
         RowBox[{"GGProcessPosterior", "[", 
          RowBox[{"data", ",", " ", "MTom"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"process", " ", "===", " ", "$Failed"}], ",", " ", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", "\n", "\n", 
        "  ", 
        RowBox[{"MultinormalDistribution", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"process", "[", "\"\<CentralValues\>\"", "]"}], ",", "\n", 
          "    ", 
          RowBox[{"GGRegularizedCovariance", "[", 
           RowBox[{
            RowBox[{"process", "[", "\"\<Covariance\>\"", "]"}], ",", " ", 
            "MTom"}], "]"}]}], "\n", "  ", "]"}]}]}], "\n", "]"}]}], 
    ";"}]}]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10003.},
 CellChangeTimes->{3.987822045810335*^9},
 CellLabel->
  "In[234]:=",ExpressionUUID->"9ef30161-35aa-3849-bacd-58a12e76218a"]
