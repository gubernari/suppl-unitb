Cell[TextData[{
 "Correlated FF samples, can be generated for instance in the following way.\
\[LineSeparator]FFs are given in the following order:\n",
 StyleBox["B->P = {f+, f0, fT};\nB->V = {V, A0, A1, A12, T1, T2, T23};", 
  "Code"]
