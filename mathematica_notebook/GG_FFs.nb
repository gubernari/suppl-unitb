Cell[BoxData[
 RowBox[{
  RowBox[{"\[Chi]1pt", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bq_", "/;", 
     RowBox[{"MemberQ", "[", 
      RowBox[{"listbq", ",", "bq"}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\[CapitalGamma]J_", "/;", 
     RowBox[{"MemberQ", "[", 
