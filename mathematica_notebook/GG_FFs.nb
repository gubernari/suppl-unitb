Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "GGFreeAlphaRules", " ", "turns", " ", "one", " ", "sample", " ", "into", 
    " ", "Mathematica", " ", "replacement", " ", "rules", " ", "for", " ", 
    "the", " ", "free", " ", "\[Alpha]", " ", 
    RowBox[{"coefficients", "."}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GGFreeAlphaRules", "[", "\n", "  ", 
      RowBox[{
      "process_Association", ",", "\n", "  ", "sample_List", ",", "\n", "  ", 
       RowBox[{"kk_Integer", "?", "Positive"}]}], "\n", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"mask", ",", " ", "info", ",", " ", "values"}], "}"}], ",", 
       "\n", "  ", 
       RowBox[{
        RowBox[{"mask", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#", "[", "\"\<k\>\"", "]"}], " ", "<", " ", "kk"}], 
            ")"}], " ", "&"}], " ", "/@", " ", 
          RowBox[{"process", "[", "\"\<ParameterInfo\>\"", "]"}]}]}], ";", 
        "\n", "  ", 
        RowBox[{"info", " ", "=", " ", 
         RowBox[{"Pick", "[", 
          RowBox[{
           RowBox[{"process", "[", "\"\<ParameterInfo\>\"", "]"}], ",", " ", 
           "mask"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"values", " ", "=", " ", 
         RowBox[{"Pick", "[", 
          RowBox[{"sample", ",", " ", "mask"}], "]"}]}], ";", "\n", "\n", 
        "  ", 
        RowBox[{"MapThread", "[", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[Alpha]", "[", 
             RowBox[{"\"\<G\>\"", ",", " ", 
              RowBox[{"process", "[", "\"\<Mm\>\"", "]"}], ",", " ", 
              RowBox[{"#1", "[", "\"\<ff\>\"", "]"}], ",", " ", 
              RowBox[{"#1", "[", "\"\<k\>\"", "]"}]}], "]"}], " ", "->", " ", 
            "#2"}], " ", "&"}], ",", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{"info", ",", " ", "values"}], "}"}]}], "\n", "  ", 
         "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"GGSampleRules", "::", "kkhigh"}], " ", "=", 
     "\"\<Requested KK = `2` for process `1`, but the posterior only provides \
free coefficients up to k = `3`.\>\""}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "GGConstrainedAlphaRules", " ", "builds", " ", "replacement", " ", 
      "rules", " ", "for", " ", "the", " ", "coefficients", " ", "that", " ", 
      "are", " ", "not", " ", "sampled", " ", "freely"}], ",", 
     RowBox[{"but", " ", "are", " ", "fixed", " ", "by", " ", "endpoint", " ", 
      RowBox[{"relations", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"GGConstrainedAlphaRules", "[", "\n", "  ", 
      RowBox[{"MTom_String", ",", "\n", "  ", 
       RowBox[{"kk_Integer", "?", "Positive"}], ",", "\n", "  ", 
       RowBox[{"Q2_", ":", " ", "0"}], ",", "\n", "  ", 
       RowBox[{"e_", ":", " ", "0"}]}], "\n", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"MmLocal", ",", " ", "ffs"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"MmLocal", " ", "=", " ", 
         RowBox[{"GGCanonicalProcessKey", "[", "MTom", "]"}]}], ";", "\n", 
        "  ", 
        RowBox[{"ffs", " ", "=", " ", 
         RowBox[{"Lookup", "[", 
          RowBox[{"GGDependentAlpha0FFs", ",", " ", "MmLocal", ",", " ", 
           RowBox[{"{", "}"}]}], "]"}]}], ";", "\n", "\n", "  ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Alpha]", "[", 
             RowBox[{
             "\"\<G\>\"", ",", " ", "MmLocal", ",", " ", "#", ",", " ", "0"}],
              "]"}], " ", ":>", " ", 
            RowBox[{"\[Alpha]GE", "[", 
             RowBox[{
             "MmLocal", ",", " ", "#", ",", " ", "0", ",", " ", "kk", ",", 
              " ", "Q2", ",", " ", "e"}], "]"}]}], ")"}], " ", "&"}], " ", 
         "/@", " ", "ffs"}]}]}], "\n", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "GGSampleRules", " ", "is", " ", "the", " ", "function", " ", "that", " ",
      "builds", " ", "the", " ", "full", " ", "set", " ", "of", " ", 
     "\[Alpha]", " ", "replacement", " ", "rules", " ", "for", " ", "one", 
     " ", "sampled", " ", "parameter", " ", 
     RowBox[{"point", "."}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"GGSampleRules", "[", "\n", "  ", 
      RowBox[{
      "data_Association", ",", "\n", "  ", "MTom_String", ",", "\n", "  ", 
       "sample_List", ",", "\n", "  ", 
       RowBox[{"kk_", ":", " ", "Automatic"}], ",", "\n", "  ", 
       RowBox[{"Q2_", ":", " ", "0"}], ",", "\n", "  ", 
       RowBox[{"e_", ":", " ", "0"}]}], "\n", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"process", ",", " ", "kkLocal", ",", " ", "maxFreeK"}], "}"}],
        ",", "\n", "  ", 
       RowBox[{
        RowBox[{"process", " ", "=", " ", 
         RowBox[{"GGProcessPosterior", "[", 
          RowBox[{"data", ",", " ", "MTom"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"process", " ", "===", " ", "$Failed"}], ",", " ", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", "\n", "\n", 
        "  ", 
        RowBox[{"kkLocal", " ", "=", " ", 
         RowBox[{"Replace", "[", 
          RowBox[{"kk", ",", " ", 
           RowBox[{"Automatic", " ", ":>", " ", 
            RowBox[{"GGProcessKK", "[", "process", "]"}]}]}], "]"}]}], ";", 
        "\n", "  ", 
        RowBox[{"maxFreeK", " ", "=", " ", 
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"process", "[", "\"\<ParameterInfo\>\"", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "\"\<k\>\""}], "]"}], "]"}], "]"}]}], 
        ";", "\n", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"kkLocal", " ", ">", " ", 
           RowBox[{"maxFreeK", " ", "+", " ", "1"}]}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"GGSampleRules", "::", "kkhigh"}], ",", " ", "MTom", ",",
              " ", "kkLocal", ",", " ", "maxFreeK"}], "]"}], ";", "\n", 
           "    ", 
           RowBox[{"Return", "[", "$Failed", "]"}], ";"}]}], "\n", "  ", 
         "]"}], ";", "\n", "\n", "  ", 
        RowBox[{"Join", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"GGFreeAlphaRules", "[", 
           RowBox[{"process", ",", " ", "sample", ",", " ", "kkLocal"}], 
           "]"}], ",", "\n", "    ", 
          RowBox[{"GGConstrainedAlphaRules", "[", 
           RowBox[{
           "MTom", ",", " ", "kkLocal", ",", " ", "Q2", ",", " ", "e"}], 
           "]"}]}], "\n", "  ", "]"}]}]}], "\n", "]"}]}], ";"}]}]}]], "Input",
