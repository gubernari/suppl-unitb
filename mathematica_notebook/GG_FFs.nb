Cell[TextData[{
 "Eq. (4.14) of ref. [1]\ns\[CapitalGamma]=sp if the threshold coincides with \
",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"M", "+", "m"}], ")"}], "2"], TraditionalForm]],ExpressionUUID->
  "da31c9df-c34e-c44e-876a-bffb1a25a22c"],
 ". Otherwise ",
 Cell[BoxData[
  FormBox[
   RowBox[{"sp", "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"M", "+", "m"}], ")"}], "2"]}], TraditionalForm]],
  ExpressionUUID->"a0b93a7f-bc2b-ac4d-9802-84583ae4e54f"],
 "(which come from the weight function, i.e. the FFs definitions) and s\
\[CapitalGamma]=threshold, which come from the definition of ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],ExpressionUUID->
  "9ba8a726-98c9-1844-8673-a0329d79b4be"]
}], "Text",
