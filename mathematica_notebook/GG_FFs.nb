      SqrtBox[
       RowBox[{"s\[CapitalGamma]", "-", "s"}]], "+", 
      SqrtBox[
       RowBox[{"s\[CapitalGamma]", "-", "sm"}]]}], ")"}], 
    FractionBox["b", "2"]], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SqrtBox[
       RowBox[{"s\[CapitalGamma]", "-", "s"}]], "+", 
      SqrtBox["s\[CapitalGamma]"]}], ")"}], 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"c", "+", "3"}], ")"}]}]], 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      RowBox[{
       SqrtBox[
        RowBox[{"s\[CapitalGamma]", "-", "s"}]], "+", 
       SqrtBox["s\[CapitalGamma]"]}], 
      RowBox[{
       SqrtBox[
        RowBox[{"s\[CapitalGamma]", "-", "s"}]], "+", 
       SqrtBox[
        RowBox[{"s\[CapitalGamma]", "+", "Q2"}]]}]], ")"}], "d"]}]}]], "Input",
