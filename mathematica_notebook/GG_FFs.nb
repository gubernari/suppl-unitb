    "the", " ", "parameters", " ", "belonging", " ", "to", " ", "process", 
    " ", 
    RowBox[{"mm", "?"}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"GGProcessIndices", "[", 
     RowBox[{"data_Association", ",", " ", "MTom_String"}], "]"}], " ", ":=", 
    " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"MmLocal", ",", " ", "prefix"}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"MmLocal", " ", "=", " ", 
