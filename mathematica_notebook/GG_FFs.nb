        RowBox[{"\"\<V-1\>\"", "|", "\"\<A-1\>\""}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<T-1\>\"", "|", "\"\<AT-1\>\""}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}]}], "\[IndentingNewLine]", "]"}]}], 
