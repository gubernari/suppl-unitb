Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"GGMmToEOSProcess", " ", "=", " ", 
    RowBox[{"<|", "\n", "  ", 
     RowBox[{
      RowBox[{"\"\<B\[Pi]\>\"", " ", "->", " ", "\"\<B->pi\>\""}], ",", "\n", 
      "  ", 
      RowBox[{"\"\<BsK\>\"", " ", "->", " ", "\"\<B_s->K\>\""}], ",", "\n", 
      "  ", 
      RowBox[{"\"\<BK\>\"", " ", "->", " ", "\"\<B->K\>\""}], ",", "\n", "  ", 
      RowBox[{"\"\<BD\>\"", " ", "->", " ", "\"\<B->D\>\""}], ",", "\n", "  ", 
      RowBox[{"\"\<BsDs\>\"", " ", "->", " ", "\"\<B_s->D_s\>\""}], ",", "\n",
       "  ", 
      RowBox[{"\"\<BsK*\>\"", " ", "->", " ", "\"\<B_s->K^*\>\""}], ",", "\n",
       "  ", 
      RowBox[{"\"\<BK*\>\"", " ", "->", " ", "\"\<B->K^*\>\""}], ",", "\n", 
      "  ", 
      RowBox[{"\"\<Bs\[Phi]\>\"", " ", "->", " ", "\"\<B_s->phi\>\""}], ",", 
      "\n", "  ", 
      RowBox[{"\"\<BD*\>\"", " ", "->", " ", "\"\<B->D^*\>\""}], ",", "\n", 
      "  ", 
      RowBox[{"\"\<BsDs*\>\"", " ", "->", " ", "\"\<B_s->D_s^*\>\""}]}], "\n",
      "|>"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GGEOSProcessToMm", " ", "=", " ", 
    RowBox[{"Association", " ", "@", " ", 
     RowBox[{"Map", "[", 
      RowBox[{"Reverse", ",", " ", 
       RowBox[{"Normal", "[", "GGMmToEOSProcess", "]"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GGCanonicalProcessKey", "[", "MTom_String", "]"}], " ", ":=", 
    " ", 
    RowBox[{"Lookup", "[", 
     RowBox[{"GGEOSProcessToMm", ",", " ", "MTom", ",", " ", "MTom"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"GGDependentAlpha0FFs", " ", "=", " ", 
   RowBox[{"Association", " ", "@", " ", 
    RowBox[{"Join", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Rule", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{"{", "\"\<f0\>\"", "}"}]}], "]"}], " ", "&"}], " ", "/@", 
       " ", 
       RowBox[{"{", 
        RowBox[{
        "\"\<B\[Pi]\>\"", ",", " ", "\"\<BsK\>\"", ",", " ", "\"\<BK\>\"", 
         ",", " ", "\"\<BD\>\"", ",", " ", "\"\<BsDs\>\""}], "}"}]}], ",", 
      "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"Rule", "[", 
         RowBox[{"#", ",", " ", 
          RowBox[{"{", 
           RowBox[{
           "\"\<A1\>\"", ",", " ", "\"\<A12\>\"", ",", " ", "\"\<T2\>\"", ",",
             " ", "\"\<T23\>\""}], "}"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{
        "\"\<BsK*\>\"", ",", " ", "\"\<BK*\>\"", ",", " ", "\"\<Bs\[Phi]\>\"",
          ",", " ", "\"\<BD*\>\"", ",", " ", "\"\<BsDs*\>\""}], "}"}]}]}], 
     "\n", "]"}]}]}], ";"}]}], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
