Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "GGProcessPosterior", " ", "takes", " ", "the", " ", "full", " ", 
     "posterior", " ", "data", " ", "and", " ", "extracts", " ", "just", " ", 
     "one", " ", "process", " ", 
     RowBox[{"block", ".", " ", "\[IndentingNewLine]", "So"}], " ", "if", " ",
      "data", " ", "contains", " ", "many", " ", "processes", " ", 
     "together"}], ",", " ", 
    RowBox[{"like", ":", " ", "B\[Pi]"}], ",", "BsK", ",", " ", 
    RowBox[{"...", ";", " ", 
     RowBox[{"then", " ", 
      RowBox[{"GGProcessPosterior", "[", 
       RowBox[{"data", ",", "\"\<BsK\>\""}], "]"}], " ", "returns", " ", "an",
       " ", "association", " ", "containing", " ", "only", " ", "the", " ", 
      "BsK", " ", 
      RowBox[{"part", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GGProcessPosterior", "[", 
      RowBox[{"data_Association", ",", " ", "MTom_String"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"Module", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "MmLocal", ",", " ", "indices", ",", " ", "names", ",", " ", "info"}],
         "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"MmLocal", " ", "=", " ", 
         RowBox[{"GGCanonicalProcessKey", "[", "MTom", "]"}]}], ";", "\n", 
        "  ", 
        RowBox[{"indices", " ", "=", " ", 
         RowBox[{"GGProcessIndices", "[", 
          RowBox[{"data", ",", " ", "MmLocal"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"indices", " ", "===", " ", "$Failed"}], ",", " ", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", "\n", "\n", 
        "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"indices", " ", "===", " ", 
           RowBox[{"{", "}"}]}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"GGProcessPosterior", "::", "empty"}], ",", " ", 
             "MmLocal"}], "]"}], ";", "\n", "    ", 
           RowBox[{"Return", "[", "$Failed", "]"}], ";"}]}], "\n", "  ", 
         "]"}], ";", "\n", "\n", "  ", 
        RowBox[{"names", " ", "=", " ", 
         RowBox[{
          RowBox[{"data", "[", "\"\<ParameterNames\>\"", "]"}], "[", 
          RowBox[{"[", "indices", "]"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"info", " ", "=", " ", 
         RowBox[{"GGParseParameterName", " ", "/@", " ", "names"}]}], ";", 
        "\n", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"info", ",", " ", "$Failed"}], "]"}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{"Return", "[", "$Failed", "]"}], ";"}]}], "\n", "  ", 
         "]"}], ";", "\n", "\n", "  ", 
        RowBox[{"<|", "\n", "    ", 
         RowBox[{
          RowBox[{"\"\<Mm\>\"", " ", "->", " ", "MmLocal"}], ",", "\n", 
          "    ", 
          RowBox[{"\"\<Indices\>\"", " ", "->", " ", "indices"}], ",", "\n", 
          "    ", 
          RowBox[{"\"\<ParameterNames\>\"", " ", "->", " ", "names"}], ",", 
          "\n", "    ", 
          RowBox[{"\"\<ParameterInfo\>\"", " ", "->", " ", "info"}], ",", 
          "\n", "    ", 
          RowBox[{"\"\<CentralValues\>\"", " ", "->", " ", 
           RowBox[{"N", " ", "@", " ", 
            RowBox[{
             RowBox[{"data", "[", "\"\<CentralValues\>\"", "]"}], "[", 
             RowBox[{"[", "indices", "]"}], "]"}]}]}], ",", "\n", "    ", 
          RowBox[{"\"\<Covariance\>\"", " ", "->", " ", 
           RowBox[{"N", " ", "@", " ", 
            RowBox[{
             RowBox[{"data", "[", "\"\<Covariance\>\"", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"indices", ",", " ", "indices"}], "]"}], "]"}]}]}]}], 
         "\n", "  ", "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"GGProcessPosterior", "::", "badmm"}], " ", "=", 
     "\"\<Unknown process key `1`. Use one of `2`.\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"GGProcessPosterior", "::", "empty"}], " ", "=", 
     "\"\<No posterior parameters were found for process `1`.\>\""}], 
    ";"}]}]}]], "Input",
