Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "It", " ", "parses", " ", "one", " ", "EOS", " ", "parameter", " ", 
     "name", " ", "string", " ", "and", " ", "turns", " ", "it", " ", "into", 
     " ", "structured", " ", "information"}], ",", " ", 
    RowBox[{"e", ".", "g", ".", "\[IndentingNewLine]", "  ", 
     RowBox[{"In", ":", " ", 
      RowBox[{
       RowBox[{
       "GGParseParameterName", "[", "\"\<B->K::a^f+_0@G2026\>\"", "]"}], " ", 
       "\[IndentingNewLine]", "Out"}], ":", " ", 
      FormBox[
       RowBox[{"\[LeftAssociation]", 
        RowBox[{
         RowBox[{"\"\<ProcessEOS\>\"", "\[Rule]", "\"\<B->K\>\""}], ",", 
         RowBox[{"\"\<Mm\>\"", "\[Rule]", "\"\<BK\>\""}], ",", 
         RowBox[{"\"\<ff\>\"", "\[Rule]", "\"\<f+\>\""}], ",", 
         RowBox[{"\"\<k\>\"", "\[Rule]", "0"}]}], "\[RightAssociation]"}],
       TraditionalForm]}]}]}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GGParseParameterName", "[", "name_String", "]"}], " ", ":=", 
     " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "parsed", "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"parsed", " ", "=", " ", 
         RowBox[{"StringCases", "[", "\n", "    ", 
          RowBox[{"name", ",", "\n", "    ", 
           RowBox[{
            RowBox[{
            "StartOfString", "\n", "      ", "~~", " ", "proc__", "\n", 
             "      ", "~~", " ", "\"\<::a^\>\"", "\n", "      ", "~~", " ", 
             "ff__", "\n", "      ", "~~", " ", "\"\<_\>\"", "\n", "      ", "~~",
              " ", 
             RowBox[{"k", " ", ":", " ", 
              RowBox[{"DigitCharacter", " ", ".."}]}], "\n", "      ", "~~", 
             " ", "\"\<@G2026\>\"", "\n", "      ", "~~", " ", 
             "EndOfString"}], " ", ":>", "\n", "        ", 
            RowBox[{"<|", "\n", "          ", 
             RowBox[{
              RowBox[{"\"\<ProcessEOS\>\"", " ", "->", " ", "proc"}], ",", 
              "\n", "          ", 
              RowBox[{"\"\<Mm\>\"", " ", "->", " ", 
               RowBox[{"Lookup", "[", 
                RowBox[{"GGEOSProcessToMm", ",", " ", "proc", ",", " ", 
                 RowBox[{"Missing", "[", 
                  RowBox[{"\"\<UnknownProcess\>\"", ",", " ", "proc"}], 
                  "]"}]}], "]"}]}], ",", "\n", "          ", 
              RowBox[{"\"\<ff\>\"", " ", "->", " ", "ff"}], ",", "\n", 
              "          ", 
              RowBox[{"\"\<k\>\"", " ", "->", " ", 
               RowBox[{"ToExpression", "[", "k", "]"}]}]}], "\n", "        ", 
             "|>"}]}]}], "\n", "  ", "]"}]}], ";", "\n", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"parsed", " ", "===", " ", 
           RowBox[{"{", "}"}]}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"GGParseParameterName", "::", "badname"}], ",", " ", 
             "name"}], "]"}], ";", "\n", "    ", "$Failed"}], ",", "\n", 
          "    ", 
