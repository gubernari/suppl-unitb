Cell[BoxData[
 RowBox[{
  RowBox[{"\[Alpha]GE", "[", 
   RowBox[{"Mm_", ",", "\"\<T23\>\"", ",", "0", ",", "KK_", ",", 
    RowBox[{"Q2_", ":", "0"}], ",", 
    RowBox[{"e_", ":", "0"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"M", "+", "m"}], ")"}], "2"], 
      RowBox[{"4", "M", "*", "m"}]], 
     FractionBox[
      RowBox[{
       RowBox[{"\[Phi]Gf", "[", 
        RowBox[{"Mm", ",", "\"\<T23\>\"", ",", "sm", ",", 
         RowBox[{"\[Chi]", "[", 
