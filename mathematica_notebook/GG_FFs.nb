          "Q2", ",", "e"}], "]"}], 
       RowBox[{"BPx", "[", 
        RowBox[{"Mm", ",", "\"\<T23\>\"", ",", "sm"}], "]"}]}], 
      RowBox[{
       RowBox[{"\[Phi]Gf", "[", 
        RowBox[{"Mm", ",", "\"\<T2\>\"", ",", "sm", ",", 
         RowBox[{"\[Chi]", "[", 
          RowBox[{"Mm", ",", "\"\<T2\>\"", ",", "Q2", ",", "e"}], "]"}], ",", 
         "Q2", ",", "e"}], "]"}], 
       RowBox[{"BPx", "[", 
        RowBox[{"Mm", ",", "\"\<T2\>\"", ",", "sm"}], "]"}]}]], 
     RowBox[{"zseries", "[", 
      RowBox[{
      "\"\<G\>\"", ",", "Mm", ",", "\"\<T2\>\"", ",", "KK", ",", "sm"}], 
      "]"}]}], "-", 
    RowBox[{"zseries", "[", 
     RowBox[{
     "\"\<G\>\"", ",", "Mm", ",", "\"\<T23\>\"", ",", "KK", ",", "sm", ",", 
      "1"}], 
     RowBox[{"(*", "start", "*)"}], "]"}]}], "//.", 
   "repl\[Chi]BP"}]}]], "Input",
