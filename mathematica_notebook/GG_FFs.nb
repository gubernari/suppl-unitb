Cell[BoxData[
 RowBox[{
  RowBox[{"\[Phi]BGLs", "[", 
   RowBox[{
   "s_", ",", "K_", ",", "a_", ",", "b_", ",", "c_", ",", "d_", ",", 
    "\[Chi]_", ",", 
    RowBox[{"Q2_", ":", "0"}]}], "]"}], ":=", 
  RowBox[{
   SqrtBox[
    FractionBox["nI", 
     RowBox[{"K", "*", "\[Pi]", "*", "\[Chi]"}]]], 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      RowBox[{"s\[CapitalGamma]", "-", "s"}], 
      RowBox[{"s\[CapitalGamma]", "-", "s0"}]], ")"}], 
    FractionBox["1", "4"]], 
   RowBox[{"(", 
    RowBox[{
     SqrtBox[
      RowBox[{"s\[CapitalGamma]", "-", "s"}]], "+", 
     SqrtBox[
      RowBox[{"s\[CapitalGamma]", "-", "s0"}]]}], ")"}], 
   SuperscriptBox[
    RowBox[{"(", 
