       "  ", 
       RowBox[{"prefix", " ", "=", " ", 
        RowBox[{"Lookup", "[", 
         RowBox[{"GGMmToEOSProcess", ",", " ", "MmLocal", ",", " ", 
          RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], "]"}]}], 
       ";", "\n", "\n", "  ", 
       RowBox[{"If", "[", 
