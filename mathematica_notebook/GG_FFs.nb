Cell[BoxData[{
 RowBox[{"Clear", "[", "h\[Chi]ANSO", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h\[Chi]ANSO", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bq_", "/;", 
     RowBox[{"MemberQ", "[", 
      RowBox[{"listbq", ",", "bq"}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"\[CapitalGamma]J_", "/;", 
     RowBox[{"MemberQ", "[", 
      RowBox[{"list\[CapitalGamma]J", ",", "\[CapitalGamma]J"}], "]"}]}], ",",
     "\[IndentingNewLine]", "Q2_", 
    RowBox[{"(*", 
     RowBox[{":", "0"}], "*)"}], ",", "\[IndentingNewLine]", "e_"}], 
   RowBox[{"(*", 
    RowBox[{":", "0"}], "*)"}], "\[IndentingNewLine]", "]"}], ":=", 
  RowBox[{"(*", "*)"}], 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "MRinside", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Select", " ", "states", " ", "are", " ", "in", " ", "the", " ", 
      RowBox[{"interval", " ", "[", 
       RowBox[{"s\[CapitalGamma]", ",", "sp"}], "]"}]}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"MRinside", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"MRlist", "[", 
         RowBox[{"bq", ",", "\[CapitalGamma]J"}], "]"}], ",", 
        RowBox[{
         RowBox[{
          SqrtBox[
           RowBox[{"s\[CapitalGamma]bq", "[", 
            RowBox[{"bq", ",", "\[CapitalGamma]J"}], "]"}]], "<", "#", "<", 
          SqrtBox[
           RowBox[{"smax", "[", "bq", "]"}]]}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Switch", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Length", "[", "MRinside", "]"}], ",", "\[IndentingNewLine]", 
       "0", ",", "\[IndentingNewLine]", 
       RowBox[{"\[Chi]ANSO", "[", 
        RowBox[{"bq", ",", "\[CapitalGamma]J", ",", "Q2", ",", "e"}], "]"}], 
       ",", "\[IndentingNewLine]", "1", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Chi]ANSO", "[", 
         RowBox[{"bq", ",", "\[CapitalGamma]J", ",", "Q2", ",", "e"}], "]"}], 
        "-", 
        RowBox[{"2", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"First", "[", "MRinside", "]"}], "2"], "+", "Q2"}], ")"}], 
         RowBox[{"\[Chi]ANSO", "[", 
          RowBox[{"bq", ",", "\[CapitalGamma]J", ",", "Q2", ",", 
           RowBox[{"e", "+", "1"}]}], "]"}]}], "+", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"First", "[", "MRinside", "]"}], "2"], "+", "Q2"}], 
           ")"}], "2"], 
         RowBox[{"\[Chi]ANSO", "[", 
          RowBox[{"bq", ",", "\[CapitalGamma]J", ",", "Q2", ",", 
           RowBox[{"e", "+", "2"}]}], "]"}]}]}], ",", "\[IndentingNewLine]", 
       "_", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"h\[Chi]ANSO", "::", "many"}], ",", 
          RowBox[{"Length", "[", "MRinside", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "$Failed"}]}], "\[IndentingNewLine]", 
      "]"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h\[Chi]ANSO", "::", "many"}], "=", 
   "\"\<There are `1` states inside the interval. The procedure is \
implemented only for 0 and 1.\>\""}], ";"}]}], "Input",
